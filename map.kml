      <Data name="icon"><value>mountain</value></Data>
      <Data name="color"><value>green</value></Data>
    </ExtendedData>
    <Point>
      <coordinates>-71.4145,44.5061,0</coordinates>
    </Point>
  </Placemark>
  <Placemark>
    <name>Mount Desert Rock Lighthouse Bar Harbor ME</name>
    <description><![CDATA[Mount Desert Rock Lighthouse<br/><br/>📍 Mount Desert Rock, ~24 miles south of Bar Harbor, ME<br/><br/>Established in 1830 on a rocky islet just 600 yards long — one of the most isolated light stations in the country, 26 miles from the nearest harbor. A granite tower replaced the original in 1847; the station was automated and de-staffed in 1977. Now a whale research and marine ecology field station operated by College of the Atlantic.<br/><br/>Tips<br/>- Grounds, dwelling, and tower closed to the public — research station only.<br/>- Whale-watching boats from Bar Harbor occasionally pass it; some operators run dedicated lighthouse cruises.]]></description>
    <styleUrl>#c-green</styleUrl>
