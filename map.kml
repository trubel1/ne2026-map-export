      <Data name="icon"><value>waves</value></Data>
      <Data name="color"><value>purple</value></Data>
    </ExtendedData>
    <Point>
      <coordinates>-72.8503,44.0181,0</coordinates>
    </Point>
  </Placemark>
  <Placemark>
    <name>Moss Glen Falls Stowe VT</name>
    <description><![CDATA[Moss Glen Falls<br/><br/>📍 Stowe VT<br/><br/>Vermont's tallest waterfall, reached via an easy 0.5-mile walk on boardwalk and granite steps just minutes from the village — uncrowded and peaceful.<br/><br/>Tips<br/>- One of the easiest big-payoff hikes in the area — good for any fitness level.<br/>- Best after rain when the falls are at full flow.]]></description>
