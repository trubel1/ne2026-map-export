  <Placemark>
    <name>Stonington Ice Cream Company Stonington ME</name>
    <description><![CDATA[Stonington Ice Cream Company<br/><br/>📍 Stonington ME<br/><br/>Harborside spot known for award-winning lobster rolls alongside homemade ice cream.<br/><br/>Must Order<br/>- Lobster roll<br/>- Homemade ice cream<br/><br/>Tips<br/>- Good casual lunch-then-dessert combo stop.]]></description>
    <styleUrl>#c-red</styleUrl>
