  <Placemark>
    <name>Ada's Kitchen Rockland ME</name>
    <description><![CDATA[Ada's Kitchen<br/><br/>📍 449 Main Street, Rockland, ME<br/><br/>A popular Italian bistro on Main Street — fresh house-made pasta, wood-fired pizzas, and craft cocktails.]]></description>
